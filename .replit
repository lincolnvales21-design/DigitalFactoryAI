modules = ["python-3.12", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "sqlite", "nano", "psmisc"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]

[objectStorage]
defaultBucketID = "replit-objstore-e067797f-112c-4db4-887b-62793bc470e3"

[[ports]]
localPort = 5000
externalPort = 80



[deployment]
run = "python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"
deploymentTarget = "cloudrun"

[env]
DIGITALFACTORY_AUTONOMOUS_ENABLED = "true"
DIGITALFACTORY_AUTONOMOUS_INTERVAL = "900"
